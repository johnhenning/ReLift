# data, caches, weights and outputs live outside version control (the default roots of configs/paths.yaml)
/data/
/cache/
/checkpoints/
/outputs/

*.pt
*.pth
*.npz
*.safetensors
!tests/fixtures/*.npz
!tests/fixtures/*.pt

__pycache__/
*.pyc
*.so
.pytest_cache/
*.egg-info/
build/
dist/
.DS_Store

# the teaser source clips (the committed teaser is assets/teaser.gif)
/assets/*.mp4

# scratch copies of the README kept for comparison
/ReLift_README_BEFORE.md

# archives dropped into the working tree (logo packs, submission bundles, downloads)
*.zip
*.tar
*.tar.gz

# editor and tooling directories
.vscode/
.idea/

# uv project environment
.venv/

# dependency wheel build output
packages/frontends/.hatch/

# Additional downloaded demo inputs (the bundled cartwheel remains tracked)
/assets/demo/*.mp4
